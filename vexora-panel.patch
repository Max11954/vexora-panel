diff --git a/installer/vexora/vexora-update b/installer/vexora/vexora-update
new file mode 100755
index 0000000..51123c3
--- /dev/null
+++ b/installer/vexora/vexora-update
@@ -0,0 +1,109 @@
+#!/usr/bin/env bash
+# vexora-update — update (or set up the updater for) a source-installed panel.
+#
+#   vexora-update            update to the latest GitHub release
+#   vexora-update --setup    (re)install updater unit, sudoers rule and .env flags only
+#
+# Installed to /usr/local/bin/vexora-update by install.sh. Needs root.
+set -euo pipefail
+
+CONF_FILE="/etc/vexora-panel.conf"
+# shellcheck disable=SC1090
+[ -f "$CONF_FILE" ] && . "$CONF_FILE"
+FP_REPO_SLUG="${FP_REPO_SLUG:-OWNER/REPO}"
+PANEL_DIR="${PANEL_DIR:-/var/www/featherpanel}"
+ENV_FILE="${PANEL_DIR}/backend/storage/config/.env"
+UNIT_FILE="/etc/systemd/system/vexora-panel-update.service"
+SUDOERS_FILE="/etc/sudoers.d/vexora-panel-update"
+SETUP_ONLY=0
+
+for arg in "$@"; do
+    case "$arg" in
+        --setup) SETUP_ONLY=1 ;;
+        --non-interactive) ;;
+        -h | --help) sed -n 2,8p "$0"; exit 0 ;;
+    esac
+done
+
+[ "$(id -u)" -eq 0 ] || { echo "Please run as root (sudo vexora-update)." >&2; exit 1; }
+
+upsert_env() {
+    local key="$1" value="$2"
+    [ -f "$ENV_FILE" ] || return 0
+    if grep -q "^${key}=" "$ENV_FILE"; then
+        sed -i "s|^${key}=.*|${key}=${value}|" "$ENV_FILE"
+    else
+        printf '%s=%s\n' "$key" "$value" >>"$ENV_FILE"
+    fi
+}
+
+setup_updater() {
+    printf 'FP_REPO_SLUG=%s\nPANEL_DIR=%s\n' "$FP_REPO_SLUG" "$PANEL_DIR" >"$CONF_FILE"
+    chmod 644 "$CONF_FILE"
+
+    cat >"$UNIT_FILE" <<UNIT
+[Unit]
+Description=Panel updater (vexora-update)
+After=network-online.target
+Wants=network-online.target
+
+[Service]
+Type=oneshot
+ExecStart=/usr/local/bin/vexora-update --non-interactive
+TimeoutStartSec=3600
+UNIT
+
+    # The web user (www-data) may start exactly this one unit, nothing else.
+    local tmp
+    tmp="$(mktemp)"
+    echo 'www-data ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block vexora-panel-update.service' >"$tmp"
+    if command -v visudo >/dev/null 2>&1 && ! visudo -cf "$tmp" >/dev/null; then
+        rm -f "$tmp"
+        echo "sudoers rule failed validation; not installing it." >&2
+        return 1
+    fi
+    install -m 0440 "$tmp" "$SUDOERS_FILE"
+    rm -f "$tmp"
+
+    systemctl daemon-reload
+
+    # Flags the panel reads: update check against our releases + enable the in-panel button.
+    upsert_env UPDATE_GITHUB_REPO "$FP_REPO_SLUG"
+    upsert_env PANEL_SOURCE_UPDATE "true"
+    echo "Updater set up for ${FP_REPO_SLUG}."
+}
+
+latest_release_tag() {
+    curl -fsSL "https://api.github.com/repos/${FP_REPO_SLUG}/releases/latest" \
+        | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1 || true
+}
+
+run_update() {
+    exec 9>/run/vexora-update.lock
+    flock -n 9 || { echo "An update is already running." >&2; exit 1; }
+
+    local tag ref_type ref script
+    tag="$(latest_release_tag)"
+    if [ -n "$tag" ]; then ref_type="tag"; ref="$tag"; else ref_type="branch"; ref="main"; fi
+    echo "Updating ${FP_REPO_SLUG} to ${ref_type} ${ref} ..."
+
+    # Run the newest update script from the repo (falls back to the local copy).
+    script="$(mktemp)"
+    if ! curl -fsSL "https://raw.githubusercontent.com/${FP_REPO_SLUG}/${ref}/installer/source/init/update.bash" -o "$script"; then
+        cp "${PANEL_DIR}/installer/source/init/update.bash" "$script"
+    fi
+    chmod +x "$script"
+
+    setup_updater   # flags must be in .env before the update restarts the backend
+    FP_REPO_SLUG="$FP_REPO_SLUG" PANEL_DIR="$PANEL_DIR" \
+        PANEL_GIT_REF_TYPE="$ref_type" PANEL_GIT_REF="$ref" \
+        bash "$script" 2>&1 | tee -a /var/log/vexora-update.log
+    rm -f "$script"
+    echo "Update finished."
+}
+
+if [ "$SETUP_ONLY" -eq 1 ]; then
+    setup_updater
+else
+    run_update
+fi
diff --git a/runner/src/processor/cidr.rs b/runner/src/processor/cidr.rs
index 97a3f01..d0e1685 100644
--- a/runner/src/processor/cidr.rs
+++ b/runner/src/processor/cidr.rs
@@ -11,16 +11,53 @@ pub fn normalize_cidr(raw: Option<i32>) -> i32 {
     }
 }
 
+/// True when the pool address is IPv6 (contains a colon, e.g. `2001:db8::2`).
+pub fn is_ipv6(ip: &str) -> bool {
+    ip.contains(':')
+}
+
+/// Like [`normalize_cidr`] but aware of the address family.
+///
+/// IPv4 keeps the old behaviour (fallback `/24`). IPv6 pools without a usable
+/// prefix fall back to `/64`, because a `/24` IPv6 prefix is never what an
+/// operator means and Proxmox/cloud-init would configure a broken network.
+pub fn normalize_cidr_for_ip(ip: &str, raw: Option<i32>) -> i32 {
+    if is_ipv6(ip) {
+        match raw {
+            Some(v) if (1..=128).contains(&v) => v,
+            _ => 64,
+        }
+    } else {
+        normalize_cidr(raw)
+    }
+}
+
 /// Read `featherpanel_vm_ips.cidr` off a MySQL row.
 ///
 /// The column is `tinyint UNSIGNED`. sqlx will not decode that as `i32`, so
 /// `try_get::<i32>("cidr").unwrap_or(24)` always fell back to `/24` even when
 /// the pool row stored `27`. Try the types sqlx actually produces, and treat
 /// NULL as "use the /24 default".
+#[allow(dead_code)]
 pub fn cidr_from_mysql_row(row: &sqlx::mysql::MySqlRow) -> i32 {
