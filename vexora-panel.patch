+    /**
+     * True when the given pool address is IPv6.
+     */
+    public static function isIpv6(string $ip): bool
+    {
+        return str_contains($ip, ':');
+    }
+
+    /**
+     * Default prefix length when a pool row has none: /64 for IPv6, /24 for IPv4.
+     */
+    public static function defaultCidr(?string $ip): int
+    {
+        return $ip !== null && self::isIpv6($ip) ? 64 : 24;
+    }
+
+    /**
+     * Build the Proxmox ip/gw fragment for an address.
+     *
+     * IPv4 => "ip=1.2.3.4/24,gw=1.2.3.1", IPv6 => "ip6=2001:db8::2/64,gw6=2001:db8::1".
+     * A missing/invalid prefix falls back to /24 (IPv4) or /64 (IPv6).
+     */
+    public static function formatIpFragment(string $ip, ?int $cidr, ?string $gateway = null): string
+    {
+        $ip = str_replace([',', '=', ' '], '', trim($ip));
+        $v6 = self::isIpv6($ip);
+        if ($cidr === null || $cidr < 1 || $cidr > ($v6 ? 128 : 32)) {
+            $cidr = $v6 ? 64 : 24;
+        }
+        $fragment = ($v6 ? 'ip6=' : 'ip=') . $ip . '/' . $cidr;
+        $gateway = $gateway !== null ? str_replace([',', '=', ' '], '', trim($gateway)) : '';
+        if ($gateway !== '') {
+            $fragment .= ($v6 ? ',gw6=' : ',gw=') . $gateway;
+        }
+
+        return $fragment;
+    }
