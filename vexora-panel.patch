new file mode 100755
index 0000000..228f95f
--- /dev/null
+++ b/install.sh
@@ -0,0 +1,49 @@
+#!/usr/bin/env bash
+# One-command installer (source install, Debian/Ubuntu):
+#
+#   curl -fsSL https://raw.githubusercontent.com/OWNER/REPO/main/install.sh | sudo bash
+#
+set -euo pipefail
+
+FP_REPO_SLUG="${FP_REPO_SLUG:-OWNER/REPO}"
+RAW="https://raw.githubusercontent.com/${FP_REPO_SLUG}/refs/heads/main"
+
+[ "$(id -u)" -eq 0 ] || { echo "Please run as root:  curl -fsSL ${RAW}/install.sh | sudo bash" >&2; exit 1; }
+command -v apt-get >/dev/null 2>&1 || { echo "This installer needs Debian or Ubuntu (apt-get)." >&2; exit 1; }
+[ -r /etc/os-release ] || { echo "Cannot detect the OS (/etc/os-release missing)." >&2; exit 1; }
+# shellcheck disable=SC1091
+. /etc/os-release
+
+# Minimum versions the underlying installer supports: Debian 11+, Ubuntu 22.04+.
+case "${ID:-}" in
+    debian) min="11" ;;
+    ubuntu) min="22.04" ;;
+    *) echo "Unsupported OS '${ID:-unknown}'. Supported: Debian 11+ and Ubuntu 22.04+." >&2; exit 1 ;;
+esac
+if [ -n "${VERSION_ID:-}" ] && dpkg --compare-versions "$VERSION_ID" lt "$min"; then
+    echo "${PRETTY_NAME:-$ID $VERSION_ID} is too old (need ${ID} ${min} or newer)." >&2
+    exit 1
+fi
+
+export DEBIAN_FRONTEND=noninteractive
+apt-get update -y >/dev/null
+apt-get install -y curl git ca-certificates >/dev/null
+
+tmp="$(mktemp -d)"
+trap 'rm -rf "$tmp"' EXIT
+curl -fsSL "${RAW}/installer/install.bash" -o "${tmp}/install.bash"
+curl -fsSL "${RAW}/installer/vexora/vexora-update" -o /usr/local/bin/vexora-update
+chmod +x /usr/local/bin/vexora-update "${tmp}/install.bash"
+printf 'FP_REPO_SLUG=%s\n' "$FP_REPO_SLUG" >/etc/vexora-panel.conf
+
+export FP_REPO_SLUG FP_PANEL_MODE=source
+if [ -r /dev/tty ]; then
+    bash "${tmp}/install.bash" "$@" </dev/tty
+else
+    bash "${tmp}/install.bash" "$@"
+fi
+
+# Activate the in-panel updater and the `vexora-update` command.
+/usr/local/bin/vexora-update --setup || echo "Note: updater setup skipped (panel not installed yet?)."
+echo
+echo "Done. Update later with:  sudo vexora-update   (or use the update button in the admin panel)"
