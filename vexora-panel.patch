diff --git a/.github/workflows/vexora-release.yml b/.github/workflows/vexora-release.yml
new file mode 100644
index 0000000..c4baae1
--- /dev/null
+++ b/.github/workflows/vexora-release.yml
@@ -0,0 +1,52 @@
+name: Vexora release
+
+# Every push to main becomes a GitHub release. The panel's update check and
+# `vexora-update` follow the latest release, so pushing is all you need to do.
+on:
+  push:
+    branches: [main]
+    paths-ignore:
+      - "**.md"
+
+permissions:
+  contents: write
+
+concurrency:
+  group: vexora-release
+  cancel-in-progress: false
+
+jobs:
+  release:
+    # Do not loop on our own version-bump commit.
+    if: "!contains(github.event.head_commit.message, '[skip release]')"
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Compute next version (last release + 1, 4th component)
+        id: ver
+        run: |
+          current=$(sed -n "s/.*define('APP_VERSION', 'v\([0-9.]*\)').*/\1/p" backend/boot/constants.php)
+          last=$(git tag --list 'v[0-9]*' --sort=-v:refname | head -n1 | sed 's/^v//')
+          base="${last:-$current}"
+          IFS=. read -r a b c d <<<"$base"
+          next="${a:-1}.${b:-0}.${c:-0}.$(( ${d:-0} + 1 ))"
+          echo "version=$next" >> "$GITHUB_OUTPUT"
+
+      - name: Write version, commit, tag
+        run: |
+          v='${{ steps.ver.outputs.version }}'
+          sed -i "s/define('APP_VERSION', '[^']*')/define('APP_VERSION', 'v${v}')/" backend/boot/constants.php
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add backend/boot/constants.php
+          git commit -m "chore: release v${v} [skip release]"
+          git tag "v${v}"
+          git push origin HEAD:main --follow-tags
+
+      - name: Create GitHub release
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: gh release create "v${{ steps.ver.outputs.version }}" --generate-notes --title "v${{ steps.ver.outputs.version }}"
