+by the Free Software Foundation, either version 3 of the License, or
+(at your option) any later version.
+
+See the LICENSE file or <https://www.gnu.org/licenses/>.
+*/
+
+const IPV4_REGEX = /^((25[0-5]|2[0-4]\d|1?\d{1,2})\.){3}(25[0-5]|2[0-4]\d|1?\d{1,2})$/;
+
+/** True for a plain IPv6 address (full or compressed, no brackets, no prefix length). */
+export function isValidIpv6(value: string): boolean {
+    const ip = value.trim();
+    if (!ip.includes(':') || !/^[0-9a-f:.]+$/i.test(ip)) {
+        return false;
+    }
+    // At most one "::" and no ":::".
+    if (ip.includes(':::') || ip.split('::').length > 2) {
+        return false;
+    }
+    // A single leading/trailing colon is only valid as part of "::".
+    if ((ip.startsWith(':') && !ip.startsWith('::')) || (ip.endsWith(':') && !ip.endsWith('::'))) {
+        return false;
+    }
+
+    let head = ip;
+    const groupsAllowed = 8;
+    // Optional embedded IPv4 tail (::ffff:1.2.3.4) counts as two groups.
+    const lastColon = ip.lastIndexOf(':');
+    const tail = ip.slice(lastColon + 1);
+    if (tail.includes('.')) {
+        if (!IPV4_REGEX.test(tail)) {
+            return false;
+        }
+        head = ip.slice(0, lastColon + 1) + '0:0';
+    }
+
+    const compressed = head.includes('::');
+    const groups = head.split(':').filter((g, i, arr) => !(g === '' && (i === 0 || i === arr.length - 1 || compressed)));
+    if (groups.some((g) => !/^[0-9a-f]{1,4}$/i.test(g))) {
+        return false;
+    }
+
+    return compressed ? groups.length < groupsAllowed : groups.length === groupsAllowed;
+}
+
+export function isValidIpv4(value: string): boolean {
+    return IPV4_REGEX.test(value.trim());
+}
+
+/** True for an IPv4 or IPv6 address. */
+export function isValidIp(value: string): boolean {
+    return isValidIpv4(value) || isValidIpv6(value);
+}
+
+/** Largest valid prefix length for the address family of `ip` (32 for IPv4, 128 for IPv6). */
+export function maxCidrFor(ip: string): number {
+    return ip.includes(':') ? 128 : 32;
+}
