         return null;
     }
 
+    /**
+     * Map the latest GitHub release of "owner/repo" to the update-server "latest" shape.
+     * Everything else the upstream update server offers (project metadata, release lists,
+     * per-version lookups) does not exist for a fork, so those paths return null.
+     *
+     * @return array<string, mixed>|null
+     */
+    private function fetchGithubLatestRelease(string $repo, string $path): ?array
+    {
+        if ($path !== '/' . self::UPDATE_PROJECT_SLUG . '/latest') {
+            return null;
+        }
+        if (preg_match('#^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$#', $repo) !== 1) {
+            return null;
+        }
+
+        $logger = App::getInstance(true)->getLogger();
+        $context = stream_context_create([
+            'http' => [
+                'timeout' => 10,
+                'user_agent' => 'Panel/' . (defined('APP_VERSION') ? APP_VERSION : 'unknown'),
+                'header' => "Accept: application/vnd.github+json\r\n",
+                'ignore_errors' => true,
+            ],
+        ]);
+        $response = @file_get_contents('https://api.github.com/repos/' . $repo . '/releases/latest', false, $context);
+        if ($response === false) {
+            $logger->warning('Failed to fetch latest GitHub release for ' . $repo);
+
+            return null;
+        }
+        $release = json_decode($response, true);
+        $tag = is_array($release) ? trim((string) ($release['tag_name'] ?? '')) : '';
+        if ($tag === '') {
+            return null;
+        }
+
+        $body = (string) ($release['body'] ?? '');
+        $name = trim((string) ($release['name'] ?? ''));
+
+        return [
+            'version' => ltrim($tag, 'vV'),
+            'type' => 'stable',
+            'release_name' => $name !== '' ? $name : $tag,
+            'release_description' => $body,
+            'description' => $body,
+            'min_supported_php' => null,
+            'max_supported_php' => null,
+            'is_security_release' => false,
+            'github_html_url' => $release['html_url'] ?? null,
+            'published_at' => $release['published_at'] ?? null,
+            'changelog_added' => [],
+            'changelog_fixed' => [],
+            'changelog_improved' => [],
+            'changelog_updated' => [],
+            'changelog_removed' => [],
+        ];
+    }
+
