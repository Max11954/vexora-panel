@@ -5593,6 +5597,59 @@ class SettingsController
         return $codes;
     }
 
+    private function isSourceUpdateEnabled(): bool
+    {
+        $flag = strtolower(trim((string) App::env('PANEL_SOURCE_UPDATE', 'false')));
+
+        return in_array($flag, ['1', 'true', 'yes', 'on'], true);
+    }
+
+    /**
+     * Source (non-Docker) installs: start the root-owned systemd oneshot that runs `vexora-update`.
+     * The web user may only run exactly this one command via sudo (see /etc/sudoers.d/vexora-panel-update).
+     */
+    private function triggerSourceUpdate(Request $request): Response
+    {
+        $user = $request->attributes->get('user');
+        $pipes = [];
+        $process = @proc_open(
+            ['sudo', '-n', '/usr/bin/systemctl', 'start', '--no-block', 'vexora-panel-update.service'],
+            [1 => ['pipe', 'w'], 2 => ['pipe', 'w']],
+            $pipes,
+        );
+        if (!is_resource($process)) {
+            return ApiResponse::error('Could not start the panel updater.', 'SOURCE_UPDATE_START_FAILED', 500);
+        }
+        $stderr = isset($pipes[2]) ? trim((string) stream_get_contents($pipes[2])) : '';
+        foreach ($pipes as $pipe) {
+            fclose($pipe);
+        }
+        $exitCode = proc_close($process);
+
+        if ($exitCode !== 0) {
+            $this->app->getLogger()->error('Source panel update failed to start: ' . $stderr);
+
+            return ApiResponse::error(
+                'The panel updater is not set up on this server. Run "vexora-update --setup" as root once.',
+                'SOURCE_UPDATE_NOT_CONFIGURED',
+                500,
+            );
+        }
+
+        Activity::createActivity([
+            'user_uuid' => $user['uuid'] ?? null,
+            'name' => 'trigger_source_panel_update',
+            'context' => 'Triggered source panel update from admin settings',
+            'ip_address' => CloudFlareRealIP::getRealIP(),
+        ]);
+
+        return ApiResponse::success(
+            ['updater' => 'systemd:vexora-panel-update.service'],
+            'Panel update started. The panel will be unavailable for a few minutes.',
+            200,
+        );
+    }
+
     private function isDockerDeployment(): bool
     {
         $flag = strtolower(trim((string) App::env('PANEL_DOCKER_DEPLOYMENT', 'false')));
